{
  "name": "rpc-proxy",
  "version": "1.0.0",
  "description": "Stellar RPC/Horizon proxy with sequential provider fallback",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start-dev": "ts-node-dev --transpile-only src/index.ts",
    "type-check": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test-coverage": "vitest run --config vitest.config.ts --coverage"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-istanbul": "^3.2.3",
    "pino-pretty": "^13.1.3",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.0",
    "vitest": "^3.2.3"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "pino": "^10.3.1",
    "undici": "^7.28.0"
  }
}
